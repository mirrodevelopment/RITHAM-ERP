# ==============================================================================
# Ritham ERP — Production Environment Configuration (.env.example)
# Copy this file to .env or set these environment variables on your system.
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT.
# ==============================================================================

# Active Spring Profile (must be 'prod' for production deployment)
SPRING_PROFILES_ACTIVE=prod

# Server Port (Spring Boot local loopback port)
SERVER_PORT=8080

# ── Local PostgreSQL Database (Office PC) ─────────────────────────────────────
# PostgreSQL remains strictly local on this machine (localhost:5432).
# NEVER expose port 5432 to the Internet.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ritham_erp
DB_USERNAME=ritham
DB_PASSWORD=REPLACE_WITH_YOUR_POSTGRESQL_PASSWORD

# Optional custom JDBC URL override (if using custom socket or params)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ritham_erp

# ── JWT Security ──────────────────────────────────────────────────────────────
# Generate a secure 256-bit Base64 secret key for production:
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=REPLACE_WITH_BASE64_256_BIT_SECRET_KEY
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# ── CORS Allowed Origins ──────────────────────────────────────────────────────
# Production frontend domains hosted on GitHub Pages
CORS_ORIGIN_1=https://mirro.in
CORS_ORIGIN_2=https://www.mirro.in

# ── Historical Migration & OCR Uploads ────────────────────────────────────────
# Persistent directory on office PC for scanned slips and document archives
MIGRATION_UPLOAD_DIR=D:/ritham-erp-uploads/migration
TESSERACT_DATA_PATH=D:/ritham-erp/tessdata
OCR_LANGUAGE=eng
